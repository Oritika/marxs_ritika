#
# Science Instrument set up and control
#
#---------------------------------------------------------------------------
MirrorType,s,h,"HRMA","HRMA|EA-MIRROR|FLATFIELD",,"Select mirror type"
GratingType,s,a,"NONE","HETG|LETG|NONE",,"Select grating type"
